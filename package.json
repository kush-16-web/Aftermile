{
  "name": "aftermile",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Aftermile — an atmospheric 3D road trip with a configurable Nissan Skyline R34 driving foundation.",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4173",
